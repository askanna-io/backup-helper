{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update supercronic version and per-arch SHA256 checksums together",
      "managerFilePatterns": [
        "/docker/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG SUPERCRONIC_VERSION=(?<currentValue>v?\\d+\\.\\d+\\.\\d+)",
        "# supercronic-linux-amd64 (?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\nARG SUPERCRONIC_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})",
        "# supercronic-linux-arm64 (?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\nARG SUPERCRONIC_SHA256_ARM64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "aptible/supercronic",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "docker.io/debian"
      ],
      "allowedVersions": "/^trixie/"
    }
  ]
}
