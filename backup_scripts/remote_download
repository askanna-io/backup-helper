#!/usr/bin/env bash

### Download a backup from a remote storage
###
### Parameters:
###     <1> filename of an existing backup on the remote storage
###
### Usage:
###     $ docker-compose -f <environment>.yml (exec |run --rm) backup_helper remote_download <1>

set -o errexit
set -o pipefail
set -o nounset

working_dir="$(dirname "${0}")"
source "${working_dir}/_sourced/constants.sh"
source "${working_dir}/_sourced/messages.sh"

if [[ "$(basename "${0}")" == gcs_* ]]; then
    message_warning "'$(basename "${0}")' is deprecated. Use 'remote_download' instead."
fi

if [[ -z "${REMOTE_URL}" ]]; then
    message_error "No remote storage configured. Set 'REMOTE_URL' to download backups from a remote storage."
    exit 1
fi

backup_filename="${1}"

# Prevent path traversal attacks
if [[ "${backup_filename}" == *..* ]] || [[ "${backup_filename}" == /* ]]; then
    message_error "Invalid filename '${backup_filename}'. Path traversal is not allowed."
    exit 1
fi

message_welcome "Download the file '${backup_filename}' from remote '${REMOTE_URL}'..."

rclone copyto "${REMOTE_URL%/}/${backup_filename}" "${BACKUP_DIR}/${backup_filename}"

message_success "The file '${backup_filename}' has been downloaded from remote '${REMOTE_URL}' to directory '${BACKUP_DIR}'."
